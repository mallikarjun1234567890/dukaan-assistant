# Copy this file to backend/.env and replace placeholders.
# Never commit .env. Never put secrets in frontend VITE_ variables.

# Required: long random string used to sign JWTs
JWT_SECRET=

# One database: Postgres. Do not use SQLite for the running app.
# Tests create their own throwaway file and never use this URL.
DATABASE_URL=postgresql+psycopg://dukaan:dukaan@localhost:5432/dukaan

# Exact browser origin allowed by CORS. Do not use "*".
CORS_ORIGINS=http://localhost:5173

# Set true when serving over HTTPS
COOKIE_SECURE=false

# Access token lifetime in minutes (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional AI chain (Gemini → Groq → hosted Hugging Face → local Ollama).
# Leave keys empty to skip a provider. Inventory still works without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
HF_TOKEN=
# Hosted HF chat needs Inference credits on the token. Empty credits skip to the next provider.
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional Cloudinary image uploads (product photo, shop logo, profile).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Razorpay keys. Shop stays usable without these.
# Keep RAZORPAY_MODE=test with rzp_test_ keys. Live keys require RAZORPAY_MODE=live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
# Advertised plan is ₹499 (49900 paise). Test mode charges BILLING_TEST_AMOUNT_PAISE.
BILLING_LIST_AMOUNT_PAISE=49900
BILLING_TEST_AMOUNT_PAISE=100

# Optional password-reset email via Resend.
# Until you verify a domain, Resend only delivers to your own inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dukaan Assistant <beth.t@example.com>
FRONTEND_URL=http://localhost:5173

# Platform admin (Dukaan owner). Not a shop. Do not commit real secrets.
ADMIN_EMAIL=admin@dukaan.local
ADMIN_PASSWORD=change-me-admin-password

# Shop-local calendar for "today's sales"
SHOP_TIMEZONE=Asia/Kolkata

# Set true only while debugging locally
DEBUG=false
